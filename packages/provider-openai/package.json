{
  "name": "dsh-media-openai",
  "version": "0.1.0",
  "description": "dsh-media-core 的 OpenAI 兼容 Provider：gpt-image 图像生成、/v1/audio/speech TTS。可对接任意 OpenAI 兼容端点。",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": ["lib", "README.md"],
  "scripts": { "build": "tsc -p tsconfig.json" },
  "keywords": ["dsh-plugin", "deepseek-harness", "cordis", "openai", "gpt-image", "tts"],
  "dependencies": { "dsh-media-core": "workspace:*" },
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.6.0" },
  "dsh": {
    "bundle": {
      "name": "media-openai",
      "requires": ["media-core"],
      "config": {
        "apiKey": { "type": "string", "description": "建议用 ${OPENAI_API_KEY}" },
        "baseUrl": { "type": "string", "default": "https://api.openai.com/v1" },
        "imageModel": { "type": "string", "default": "gpt-image-1" },
        "ttsModel": { "type": "string", "default": "gpt-4o-mini-tts" }
      }
    }
  }
}

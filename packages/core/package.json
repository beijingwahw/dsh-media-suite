{
  "name": "dsh-media-core",
  "version": "0.1.0",
  "description": "DeepSeek Harness 多模态生成核心插件：统一生成协议、任务队列、产物管理、预算限流。Provider 以独立插件热插拔接入。",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": ["lib", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "keywords": ["dsh-plugin", "deepseek-harness", "cordis", "media", "multimodal"],
  "dependencies": {
    "better-sqlite3": "^11.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dsh": {
    "bundle": {
      "name": "media-core",
      "provides": ["media"],
      "events": ["media/provider:register", "media/task:updated", "media/artifact:created"],
      "config": {
        "defaultProvider": { "type": "object" },
        "budget": { "type": "object" },
        "concurrency": { "type": "object" },
        "outputDir": { "type": "string", "default": "assets/media" },
        "storage": { "type": "string", "enum": ["sqlite", "memory"], "default": "sqlite" }
      }
    }
  }
}
